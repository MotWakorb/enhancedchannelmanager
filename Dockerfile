    apk add --no-cache gnupg \
    && python /build-scripts/prepare_alpine_rust_sources.py \
        --external-root /proof/external-sources --runtime-inventory /proof/runtime-inventory.json \
        --output-dir /proof/rust-sources --work-dir /proof/rust-source-work \
        --receipt-file /proof/rust-source-receipt.json

