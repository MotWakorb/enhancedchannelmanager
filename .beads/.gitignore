# SQLite databases
*.db
*.db?*
*.db-journal
*.db-wal
*.db-shm

# Daemon runtime files
daemon.lock
daemon.log
daemon.pid
bd.sock

# Local version tracking (prevents upgrade notification spam after git ops)
.local_version

# Legacy database files
db.sqlite
bd.db

# Merge artifacts (temporary files from 3-way merge)
beads.base.jsonl
beads.base.meta.json
beads.left.jsonl
beads.left.meta.json
beads.right.jsonl
beads.right.meta.json

# Local tool runtime artifacts, same class as the .playwright-mcp/ sweep
# (bead enhancedchannelmanager-6mqn5): untracked and unignored on every
# branch. Confirmed via `git ls-files .beads/`, which returns only
# .gitignore, README.md, config.yaml, issues.jsonl, issues.jsonl.bak, and
# metadata.json -- none of the paths below are among them.
backup/
embeddeddolt/
interactions.jsonl
last-touched
.auto-import-issues.jsonl

# Keep JSONL exports and config (source of truth for git)
!issues.jsonl
!metadata.json
!config.json
