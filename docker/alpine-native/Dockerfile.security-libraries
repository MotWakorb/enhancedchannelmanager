# Incremental owned security-provider builder. Not a production runtime image.
FROM python:3.12-alpine3.24@sha256:e064671ca452259bab50e8e2c7bd896e39e9a343bb06ca25234adf6fe18d0fc7 AS security-builder
COPY scripts/alpine_repository_policy.py /proof/scripts/alpine_repository_policy.py
RUN python /proof/scripts/alpine_repository_policy.py \
    && apk upgrade --no-cache \
    && apk add --no-cache build-base bash coreutils binutils patch pkgconf \
        xz-dev zlib-dev bzip2-dev libxml2-dev cargo cargo-c rust meson \
        cairo-dev dav1d-dev font-dejavu gdk-pixbuf-dev glib-dev pango-dev
COPY scripts/build_native_runtime.py scripts/build_alpine_codecs.py scripts/build_alpine_security_libraries.py /proof/scripts/
COPY docker/alpine-native/ /proof/recipe/
COPY --from=security-cache / /proof/cache/
RUN --network=none --mount=type=cache,target=/proof/cargo-target \
    case "$(uname -m)" in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) exit 1 ;; esac \
    && python /proof/scripts/build_alpine_security_libraries.py \
        --manifest /proof/recipe/security-libraries.json --arch "$arch" \
        --work-dir /proof/work --output-dir /proof/output --cache-dir /proof/cache

FROM scratch AS security-evidence
COPY --from=security-builder /proof/output/ /
