# Approved seventh source-owned provider; not a production runtime image.
FROM python:3.12-alpine3.24@sha256:e064671ca452259bab50e8e2c7bd896e39e9a343bb06ca25234adf6fe18d0fc7 AS jxl-builder
COPY scripts/alpine_repository_policy.py /proof/scripts/alpine_repository_policy.py
RUN python /proof/scripts/alpine_repository_policy.py \
    && apk upgrade --no-cache \
    && apk add --no-cache build-base cmake pkgconf binutils patch bash coreutils \
        brotli-dev highway-dev
COPY scripts/build_native_runtime.py scripts/build_alpine_codecs.py scripts/build_alpine_security_libraries.py scripts/build_alpine_jxl.py /proof/scripts/
COPY docker/alpine-native/ /proof/recipe/
COPY --from=jxl-cache / /proof/cache/
RUN --network=none case "$(uname -m)" in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) exit 1 ;; esac \
    && python /proof/scripts/build_alpine_jxl.py --manifest /proof/recipe/libjxl.json \
        --arch "$arch" --work-dir /proof/work --output-dir /proof/output --cache-dir /proof/cache

FROM scratch AS jxl-evidence
COPY --from=jxl-builder /proof/output/ /
