# Build-only signing and installation proof. Not an ECM runtime image.
FROM python:3.12-alpine3.24@sha256:e064671ca452259bab50e8e2c7bd896e39e9a343bb06ca25234adf6fe18d0fc7 AS packager
COPY scripts/alpine_repository_policy.py /proof/scripts/alpine_repository_policy.py
RUN python /proof/scripts/alpine_repository_policy.py \
    && apk upgrade --no-cache && apk add --no-cache openssl binutils
COPY scripts/build_native_runtime.py scripts/build_alpine_*.py scripts/package_alpine_native.py /proof/scripts/
COPY --from=codec-evidence / /proof/components/codecs/
COPY --from=security-evidence / /proof/components/security/
COPY --from=jxl-evidence / /proof/components/jxl/
COPY --from=ffmpeg-evidence / /proof/components/ffmpeg/
COPY --from=gosu-evidence / /proof/components/gosu/
RUN --network=none case "$(uname -m)" in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) exit 1 ;; esac \
    && python /proof/scripts/package_alpine_native.py --arch "$arch" \
        --codecs-dir /proof/components/codecs --security-dir /proof/components/security \
        --jxl-dir /proof/components/jxl --ffmpeg-dir /proof/components/ffmpeg \
        --gosu-dir /proof/components/gosu --work-dir /proof/work --output-dir /proof/output

FROM python:3.12-alpine3.24@sha256:e064671ca452259bab50e8e2c7bd896e39e9a343bb06ca25234adf6fe18d0fc7 AS installation-proof
COPY scripts/alpine_repository_policy.py /proof/scripts/alpine_repository_policy.py
RUN python /proof/scripts/alpine_repository_policy.py && apk upgrade --no-cache
COPY scripts/build_native_runtime.py scripts/build_alpine_*.py scripts/package_alpine_native.py scripts/install_alpine_native.py /proof/scripts/
COPY --from=packager /proof/output/ /proof/packages/
# Resolve only real ELF dependencies through the signed stable repositories.
# External APK/source/advisory closure is a separate final-image gate.
RUN python -c 'import json, subprocess; from pathlib import Path; p=json.loads(Path("/proof/packages/package-output.json").read_text()); subprocess.run(["/sbin/apk", "add", "--no-cache", *p["external_dependencies"]], check=True)'
RUN --network=none case "$(uname -m)" in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) exit 1 ;; esac \
    && python /proof/scripts/install_alpine_native.py --arch "$arch" \
        --packages-dir /proof/packages --evidence-file /proof/install-output.json \
    && ffmpeg -version && ffprobe -version \
    && test "$(gosu 1571:1572 /usr/bin/id -u)" = 1571 \
    && test "$(gosu 1571:1572 /usr/bin/id -g)" = 1572
COPY scripts/verify_alpine_ffmpeg.py /proof/scripts/verify_alpine_ffmpeg.py
COPY docker/alpine-native/ffmpeg-baseline.json /proof/docker/alpine-native/ffmpeg-baseline.json
COPY docs/design/evidence/stable-alpine-native-original-arm64-20261109.json.gz /proof/docs/design/evidence/stable-alpine-native-original-arm64-20261109.json.gz
COPY tests/native_image/runtime_checks.py tests/native_image/rare_inputs.json /proof/fixtures/
RUN --network=none python /proof/scripts/verify_alpine_ffmpeg.py \
    --fixtures-dir /proof/fixtures --output-file /proof/ffmpeg-behavior.json

FROM scratch AS package-evidence
COPY --from=packager /proof/output/ /
COPY --from=installation-proof /proof/install-output.json /install-output.json
COPY --from=installation-proof /proof/ffmpeg-behavior.json /ffmpeg-behavior.json
