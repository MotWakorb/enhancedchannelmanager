# Disposable installation/behavior proof only. Not a production ECM/MCP image.
FROM python:3.12-alpine3.24@sha256:e064671ca452259bab50e8e2c7bd896e39e9a343bb06ca25234adf6fe18d0fc7 AS busybox-runtime
COPY scripts/alpine_repository_policy.py /proof/scripts/alpine_repository_policy.py
RUN python /proof/scripts/alpine_repository_policy.py && apk upgrade --no-cache
COPY scripts/build_native_runtime.py scripts/build_alpine_*.py scripts/build_resdet.py scripts/generate_sbom.py scripts/package_alpine_native.py scripts/install_alpine_native.py scripts/build_busybox_provider.py scripts/install_busybox_provider.py scripts/alpine_apk_v2.py scripts/verify_musllinux_gnu.py scripts/probe_busybox_runtime.py scripts/busybox_static_sources.py /proof/scripts/
COPY docker/alpine-busybox/manifest.json /proof/policy/manifest.json
# Do not copy unused upstream subpackages or vulnerable original APK witnesses.
COPY --from=busybox-packages runtime-packages/ /proof/packages/runtime-packages/
COPY --from=busybox-packages ecm-busybox.rsa.pub build-output.json check-output.json check.log /proof/packages/
COPY --from=busybox-packages sources/ /proof/packages/sources/
RUN --network=none case "$(uname -m)" in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) exit 1 ;; esac \
    && python /proof/scripts/install_busybox_provider.py --packages-dir /proof/packages \
        --arch "$arch" --manifest /proof/policy/manifest.json --evidence-file /proof/evidence/install-output.json \
    && python /proof/scripts/probe_busybox_runtime.py --output-file /proof/evidence/runtime-output.json

FROM scratch AS busybox-installed-evidence
COPY --from=busybox-runtime /proof/evidence/ /
