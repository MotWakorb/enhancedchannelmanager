 #include "libbb.h"
+
+#if ENABLE_DESKTOP && ENABLE_FEATURE_TIMEZONE
+/* strptime %z is not provided by every supported libc. Keep numeric timezone
+ * input local to BusyBox rather than adding a libc compatibility interface. */
+static char *parse_numeric_timezone(char *value, long *offset)
+{
+	unsigned hours, minutes, i;
+	if (*value == 'Z') {
+		*offset = 0;
+		return value + 1;
+	}
+	if ((*value != '+' && *value != '-') || strlen(value) < 5)
+		return NULL;
+	for (i = 1; i <= 4; i++)
+		if (!isdigit((unsigned char)value[i]))
+			return NULL;
+	hours = (value[1] - '0') * 10 + value[2] - '0';
+	minutes = (value[3] - '0') * 10 + value[4] - '0';
+	if (hours > 23 || minutes > 59)
+		return NULL;
+	*offset = (hours * 60 + minutes) * 60;
+	if (*value == '-')
+		*offset = -*offset;
+	return value + 5;
+}
+#endif
 
