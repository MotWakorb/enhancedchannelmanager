venv/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.dist_root/
# CSS chunk-leak audit build output (vite.audit.config.ts). Was untracked AND
# unignored, so it polluted `git status` and broke `npm run lint`.
frontend/.audit-dist/
# Dev-only modal harness build output (bead enhancedchannelmanager-xhldy.1).
# Never deployed; produced by `vite build --config vite.harness.config.ts`.
frontend/.modal-harness-dist/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code temp files
tmpclaude-*-cwd

# Build
backend/static/
*.egg-info/
dist/
build/

# Test coverage artifacts (enforced in CI, see docs/testing.md)
frontend/coverage/
backend/.coverage
backend/coverage.xml
backend/htmlcov/
mcp-server/.coverage
mcp-server/coverage.xml
mcp-server/htmlcov/

# JUnit XML reports — emitted in CI for the flake-pr-comment workflow
# (bead xq19y) and locally when running pytest/vitest with --junitxml.
backend/junit.xml
frontend/junit.xml
mcp-server/junit.xml

# pytest-benchmark local result store (bd-skqln.10). CI uses --benchmark-storage
# under /tmp; this guard catches local runs that default to ./.benchmarks/.
backend/.benchmarks/
backend/tests/performance/.benchmarks/

# Screenshots of a live instance (may contain PII). The default is to ignore
# everything under docs/images/ — captures taken against a real instance can
# render Xtream stream URLs (provider password is in the path), provider
# hostnames, private/public IPs, real email addresses, and account usernames.
# This repository is public, so an accidental `git add` is unrecoverable.
#
# Exception (bd-2mluw): docs/images/user_guide/ is tracked. Those screenshots
# are captured against the sanitized documentation environment — placeholder
# hosts (dispatcharr.example.local), the `e2e_test` operator, pseudonymized
# provider names, empty credential fields, and provider-identifying strings
# blurred at capture time. Every file under it was individually PII-audited
# before being committed. Anything added there later must clear the same bar.
# `docs/images/*` (not `docs/images/`) is required: git will not descend into
# an excluded directory, so a negation under it can never re-include anything.
docs/images/*
!docs/images/user_guide/

# Playwright run-time artifacts (bd-lln2x). The visual-regression
# baseline PNGs under e2e/visual/__screenshots__/ ARE checked in (they
# are the test oracle); only ephemeral run output is excluded.
test-results/
test-results-visual/
playwright-report/
frontend/test-results/
